{
  "openapi": "3.0.0",
  "info": {
    "title": "Incident RCA Evidence API",
    "description": "Search historical incident and change evidence to support root cause analysis. Returns grounded matches from Cosmos DB with similarity scores, historical incidents, and related change records.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://td-rca-api.azurewebsites.net",
      "description": "Azure App Service production server"
    }
  ],
  "paths": {
    "/api/rca/evidence": {
      "post": {
        "operationId": "search_incident_rca_evidence",
        "summary": "Search RCA Evidence",
        "description": "Search historical incident and change evidence to support root cause analysis. Use this for every RCA request before determining a root cause.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "incident_description": {
                    "type": "string",
                    "description": "The user's complete incident description. Can be short and nontechnical (e.g., 'Mobile banking app not working'). Preserve the original user text without modification.",
                    "example": "Mobile banking app not working"
                  },
                  "top_incident_count": {
                    "type": "integer",
                    "description": "Maximum number of historical incidents to return. Default is 3. Lower values focus on top matches, higher values provide more context.",
                    "minimum": 1,
                    "maximum": 5,
                    "default": 3,
                    "example": 3
                  }
                },
                "required": ["incident_description"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully retrieved evidence",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "interpreted_context": {
                      "type": "object",
                      "properties": {
                        "business_service": { "type": "string", "description": "Inferred business service name" },
                        "service_key": { "type": "string", "description": "Normalized service partition key" },
                        "probable_application": { "type": "string", "description": "Likely application name" },
                        "symptoms": { "type": "array", "items": { "type": "string" }, "description": "Identified symptoms" },
                        "keywords": { "type": "array", "items": { "type": "string" }, "description": "Extracted keywords" }
                      }
                    },
                    "historical_matches": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "incident_id": { "type": "string", "description": "Historical incident ID" },
                          "similarity_score": { "type": "integer", "description": "Similarity score (0-100)" },
                          "score_breakdown": {
                            "type": "object",
                            "properties": {
                              "service": { "type": "integer" },
                              "application": { "type": "integer" },
                              "symptoms": { "type": "integer" },
                              "tags": { "type": "integer" },
                              "error_code": { "type": "integer" },
                              "configuration_item": { "type": "integer" }
                            }
                          },
                          "incident_title": { "type": "string" },
                          "root_cause": { "type": "string" },
                          "root_cause_category": { "type": "string" },
                          "linked_change_id": { "type": "string" }
                        }
                      }
                    },
                    "related_changes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "change_id": { "type": "string" },
                          "change_title": { "type": "string" },
                          "validation_result": { "type": "string" },
                          "rollback_performed": { "type": "boolean" },
                          "post_implementation_issues": { "type": "array", "items": { "type": "string" } },
                          "change_supported": { "type": "boolean", "description": "True if change evidence supports the root cause" }
                        }
                      }
                    },
                    "request_id": { "type": "string" },
                    "timestamp": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad request - invalid input" },
          "500": { "description": "Internal server error" },
          "503": { "description": "Service unavailable - Cosmos DB connection failed" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "noAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "No authentication required for local development"
      }
    }
  },
  "security": []
}
