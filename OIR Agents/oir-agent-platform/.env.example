# Copy to .env for local runs (func/pytest don't auto-load this — export
# manually or use `az functionapp config appsettings set` / Key Vault for
# real deployments). Never commit a real .env.

# --- Confirmed for the TD-BANK-POC tenant (2026-08-06) ---------------------
# COSMOS_ENDPOINT/COSMOS_KEY replaced SHAREPOINT_SITE_URL, which itself
# replaced DATAVERSE_URL -- see docs/decisions/0002-cosmos-db-instead-of-
# sharepoint-lists.md and docs/decisions/0001-sharepoint-lists-instead-of-
# dataverse.md for the full history.
COSMOS_ENDPOINT=https://td-bank-cosmos.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DATABASE=OIRPlatform
FOUNDRY_PROJECT_ENDPOINT=https://td-bank.services.ai.azure.com/api/projects/TD-BANK

# --- Service principal (from infra/deploy_infra.ps1 -- keep secret) --------
AZURE_TENANT_ID=6efbfbdd-57af-4e28-9f2c-9b75f72a6ffe
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Observability -----------------------------------------------------
APPINSIGHTS_INSTRUMENTATIONKEY=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Teams bot -----------------------------------------------------------
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_PASSWORD=
PMO_TEAMS_WEBHOOK_URL=

# --- Foundry agent invocation (direct thread/run API via functions/shared/
#     foundry_client.py, using the AZURE_CLIENT_* credentials above --
#     agent IDs come from agents/.deployed_agents.json after deploy_agents.py) ---
FOUNDRY_DIGEST_AGENT_ID=
FOUNDRY_REPLY_INTERPRETER_AGENT_ID=

# --- ApplyUpdate function (used by the Teams bot) --------------------------
APPLY_UPDATE_FUNCTION_URL=
APPLY_UPDATE_FUNCTION_KEY=

# --- Authorisation / shadow mode --------------------------------------------
PMO_GROUP_ID=
PMO_OWNER_EMAIL=
SHADOW_MODE=true
