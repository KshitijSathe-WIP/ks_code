# Azure Cosmos DB Configuration
AZURE_COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
AZURE_COSMOS_DATABASE=IncidentRCA
AZURE_COSMOS_INCIDENT_CONTAINER=historical-incidents
AZURE_COSMOS_CHANGE_CONTAINER=change-records

# Microsoft Foundry Configuration
AZURE_AI_PROJECT_ENDPOINT=https://your-foundry-project.cognitiveservices.azure.com/
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4

# Application Configuration
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Authentication
# Local development uses DefaultAzureCredential (Azure CLI or managed identity)
# Ensure you are logged in with: az login
